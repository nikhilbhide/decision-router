# Hosted Jev through Vercel AI Gateway.
AI_GATEWAY_API_KEY=
# Optional hosted LLM baseline / fallback, sharing the Vercel key above.
# Export these in your shell; .env files are not loaded automatically.
LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
LLM_MODEL=alibaba/qwen-3-32b
# Alternative: use https://router.huggingface.co/v1 with
# LLM_MODEL=Qwen/Qwen3.5-35B-A3B:deepinfra and HF_TOKEN.
HF_TOKEN=
# For custom compatible services only.
LLM_API_KEY=
