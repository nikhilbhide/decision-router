# Optional Hugging Face hosted LLM baseline / fallback.
# Export these in your shell; .env files are not loaded automatically.
HF_TOKEN=
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=Qwen/Qwen3.5-35B-A3B:deepinfra
# Alternative Vercel LLM: use https://ai-gateway.vercel.sh/v1 and
# LLM_MODEL=alibaba/qwen-3-32b with AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
# For custom compatible services only.
LLM_API_KEY=
